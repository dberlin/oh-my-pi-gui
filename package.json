{
  "name": "@oh-my-pi/omp-gui",
	"version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Desktop GUI for the omp coding agent",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && electron .",
    "package": "bun run build && electron-builder",
    "package:mac": "bun run build && electron-builder --mac",
    "package:mac:arm64": "bun run build && electron-builder --mac --arm64",
    "package:mac:x64": "bun run build && electron-builder --config electron-builder.x64.yml --mac --x64",
    "package:win": "bun run build && electron-builder --win",
    "package:linux": "bun run build && electron-builder --linux",
    "gen:types": "bun scripts/gen-types.ts",
    "gen:icons": "bun scripts/gen-icons.ts",
    "build:omp": "bun scripts/build-bundled-omp.ts",
    "build:omp:x64": "bun scripts/build-bundled-omp.ts --target bun-darwin-x64",
    "check": "node scripts/lint-surfaces.mjs && biome check . && tsc --noEmit",
    "check:types": "tsc --noEmit",
    "lint": "biome lint .",
    "fix": "biome check --write --unsafe .",
    "fmt": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "vitest bench"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/view": "^6.43.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.5.1",
    "chokidar": "^5.0.0",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "electron": "43.4.0",
    "electron-builder": "^26.15.3",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.10"
  }
}
