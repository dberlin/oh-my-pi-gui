{
  "base": "892adf914b843fe478793aa0f83a4218e7c49ff0",
  "fork": "358d4bea",
  "upstream": "7b8f6a54",
  "rebaseApplied": false,
  "parentSections": [
    {
      "id": "S1",
      "title": "Navigation and action discovery",
      "note": "Adds a compact Command Center icon, Session actions and Tab actions menus, sidebar Capabilities entry, and command shortcut hint. The current fork already has a large Commands field; adopting these additions must not remove its existing controls or activity rail. Integrated placement will be shown again if conflict resolution changes the approved layout."
    },
    {
      "id": "S2",
      "title": "Command Center semantics and availability",
      "note": "Adds Git, Hub, Modes, Restart Core, Close Window and Delete Session commands; renames login/logout and app-wide Quit. Argument-taking selections prefill the composer instead of running incomplete commands. Chat-only, terminal-only and disconnected actions become visibly disabled with reasons; native window commands remain available. Failed command loads show an error and Retry. Source-exact state inventory is included below; the component-state gallery covers the shared disabled/error treatment."
    },
    {
      "id": "C1",
      "title": "Edit Draft and workspace-aware prompt history",
      "note": "Adds visible Edit Draft and History toolbar buttons. History defaults to the current workspace, offers All workspaces, adds path/legacy-entry attribution, and records only accepted sends. Outside click and Escape dismiss the overlay. Arrow recall remains isolated to its owning tab/session."
    },
    {
      "id": "C2",
      "title": "Large paste can be cancelled",
      "note": "Before: three choices; Escape inserts the pasted content. Upstream: a fourth Cancel button; Escape and outside click cancel without insertion. These are real paste-handler captures using identical 3,000-line clipboard event fixtures."
    },
    {
      "id": "C3",
      "title": "Model delegation completion and chips",
      "note": "Typing ^ offers canonical provider/model suggestions in agent sessions; submitted delegation tags are removed from the prose and displayed as named Bot chips. Tool-free chat sessions do not offer delegation. The transcript gallery also shows the resulting chips."
    },
    {
      "id": "C4",
      "title": "Modes and reasoning controls",
      "note": "Modes adds Prewalk to the More toggles and active summary, and navigation chevrons for Goal/Loop/Vibe/Roles. Approval and Thinking menus gain selected-radio focus and Arrow/Home/End navigation; their open/close motion appears under A1."
    },
    {
      "id": "M1",
      "title": "Capabilities becomes a native action launcher",
      "note": "Retains the existing seven discovery cards and adds Command Center, Quick actions, and grouped Model/Providers/Extensions/Modes/Session/PR/Stats/Security/System/Copy actions. All three upstream scroll positions are shown; this is not merely the first screenful."
    },
    {
      "id": "Q1",
      "title": "Explicit full-access safety gate",
      "note": "Choosing Full access from a stricter mode applies immediately before. Upstream asks for confirmation, explains unrestricted file/command/network calls, warns the setting persists for new sessions, and autofocuses Cancel. Normal stricter-mode changes remain immediate."
    },
    {
      "id": "K1",
      "title": "Shortcut ownership and close semantics",
      "note": "Hotkeys adds Native menu chords, remappable ⌘W Close tab, reserved ⌃G Edit Draft and composer History ownership. Native/composer collisions show specific blocking errors or warnings. Close chip, ⌘W and menu Close Tab share the same live-run confirmation; final-tab close closes only that window. Tab arrows/Home/End rove focus. Settings Cmd/Ctrl+K focuses its search."
    },
    {
      "id": "K2",
      "title": "Native menus, safety warnings, tray and window restoration",
      "note": "Expands macOS View/Session menus; adds Window and Tools menus. App-wide quit with live work asks before stopping sessions; changed installation resources ask before restart. Tray names the aggregate Idle/Running/Needs input/Error state and handles unknown context capacity. All saved windows/layouts restore, off-screen windows fit the current work area, explicit workspace paths focus/open their workspace; Windows menu bar auto-hides. The illustrations below are explicitly distinguished from OS captures."
    },
    {
      "id": "A1",
      "title": "Streaming, row, overlay and drawer motion; scroll intent",
      "note": "Actual base/upstream recordings show streamed text and Command Center transitions. Upstream uses append-only streaming reveals, one-shot genuine-arrival row animation, 150ms retained-content modal/popover exits, context-menu pop-in, right-entry drawers and global color transitions. Reduced-motion skips reveal/exit effects. Scroll preserves reading anchors, repins only near the tail after tailward gestures, and sending returns to the live edge. Panel width persists and supports keyboard resizing. Videos show motion; static cards cannot approve it by themselves."
    },
    {
      "id": "W1",
      "title": "Public download site",
      "note": "Landing page moves into site/ (assets are unchanged moves), adds Windows x64 download choices and platform-specific first-launch guidance, updates its release fallback to v0.9.11 and dynamically reads the latest release. Nav changes Download to Choose a build, and feature chips include structured job coordination. Wide/mobile hero, Updates and Install are shown."
    },
    {
      "id": "D1",
      "title": "Release version and documentation-only screenshots",
      "note": "GUI version advances 0.9.6 → 0.9.11. README/release copy adds the new capabilities and Windows install/packaging instructions. The 24 new English/Chinese screenshots below are documentation assets, not proposed removal of fork UI. Click any thumbnail to inspect full resolution; all twelve surfaces per language are included."
    }
  ],
